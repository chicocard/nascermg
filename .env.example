# Copie para .env e ajuste.
# UF do piloto (sigla usada nos nomes dos arquivos do DATASUS)
UF=MG
# Anos (separados por vírgula). SIM e SINASC são anuais; SIH é mensal (12 arquivos/ano).
ANOS=2022,2023
# Competência do CNES usada como "foto" da estrutura em cada ano (mês, 2 dígitos)
CNES_MES=12
# Quais bases baixar (separadas por vírgula). Opções: SINASC,SIM,DOFET,SIH_RD,CNES_LT,CNES_ST,SINAN_SIFC
# SINAN_SIFC = sífilis congênita (arquivo nacional SIFCBRaa.dbc, ~1 MB por ano; a UF é filtrada no dbt)
BASES=SINASC,SIM,DOFET,SIH_RD,CNES_LT,CNES_ST,SINAN_SIFC
# Diretórios dentro do container (não altere a menos que mude o docker-compose)
DATA_DIR=/data
# Ano para a tabela de municípios/regiões (apenas informativo nos metadados)
ANO_TERRITORIO=2023
# Pasta (no Windows) com os mapas de polígonos: .MAP do TabWin (uf_municip.MAP, uf_regsaud.MAP, uf_macsaud.MAP),
# shapefile do IBGE ou GeoJSON. Use barras normais. Padrão: ./data/malhas
MALHA_DIR_HOST=./data/malhas
